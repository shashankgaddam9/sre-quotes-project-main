#!/bin/bash
# Runs ONCE when the server first boots. Output is saved to /var/log/user-data.log
# (read it with: sudo cat /var/log/user-data.log) — the first place to look if the site doesn't come up.
set -euxo pipefail
exec > >(tee /var/log/user-data.log) 2>&1

# 1. Add 1 GB of swap so a small server doesn't run out of memory
fallocate -l 1G /swapfile
chmod 600 /swapfile
mkswap /swapfile
swapon /swapfile
echo '/swapfile none swap sw 0 0' >> /etc/fstab

# 2. Install Docker, Docker Compose and git
dnf install -y docker git
systemctl enable --now docker
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-x86_64 \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

# 3. Download your project from GitHub
git clone --branch ${branch} ${repo_url} /opt/sre-quotes
cd /opt/sre-quotes

# 4. Settings for docker-compose.aws.yml
cat > .env <<EOF
AWS_REGION=${region}
LOG_GROUP=${log_group}
GRAFANA_PASSWORD=${grafana_password}
EOF
chmod 600 .env

# 5. Start the site
export APP_VERSION="$(git rev-parse --short HEAD)"
docker compose -f docker-compose.yml -f docker-compose.aws.yml up -d --build

echo "Setup finished"

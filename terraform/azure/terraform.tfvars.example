# Copy this file to terraform.tfvars and fill in your values:
#   cp terraform.tfvars.example terraform.tfvars
# terraform.tfvars is in .gitignore — never commit it.

subscription_id = "00000000-0000-0000-0000-000000000000"   # az account show --query id -o tsv
repo_url        = "https://github.com/YOUR_GITHUB_USER/sre-quotes-project.git"
my_ip_cidr      = "203.0.113.10/32"                        # $(curl -s https://checkip.amazonaws.com)/32
alert_email     = "you@your-school.edu"

# Optional:
# location            = "eastus"
# vm_size             = "Standard_B1s"
# ssh_public_key_path = "~/.ssh/id_ed25519.pub"
